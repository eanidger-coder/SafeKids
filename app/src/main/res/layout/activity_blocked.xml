<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FFEBEE"
    android:layoutDirection="rtl"
    android:padding="32dp">

    <!-- Friendly emoji -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛑"
        android:textSize="80sp" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/block_title"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/sk_error"
        android:layout_marginTop="16dp" />

    <!-- Message -->
    <TextView
        android:id="@+id/tvBlockMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/block_message"
        android:textSize="18sp"
        android:textColor="@color/sk_on_background"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:layout_marginTop="16dp" />

    <!-- Back to safe -->
    <Button
        android:id="@+id/btnBackToSafe"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:text="@string/block_btn_back"
        android:textSize="16sp"
        android:backgroundTint="@color/sk_secondary" />

    <!-- Parent unlock -->
    <Button
        android:id="@+id/btnParentUnlock"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="@string/block_btn_parent"
        android:textSize="14sp" />

</LinearLayout>
