<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/safekids_background_premium"
    android:layoutDirection="rtl">

    <!-- Header / Logo -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_security_shield"
            app:tint="@color/sk_neon_cyan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-black"
            android:text="SafeKids"
            android:textColor="@color/sk_white"
            android:textSize="28sp" />
    </LinearLayout>

    <!-- Main Control Card (Glassmorphism) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        app:cardBackgroundColor="@color/sk_glass_background"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llHeader"
        app:strokeColor="@color/sk_glass_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/tvProtectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/main_protection_active"
                android:textColor="@color/sk_neon_cyan"
                android:textSize="20sp" />

            <!-- BIG GLOWING TOGGLE (using a card button) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnToggleProtection"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="32dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/sk_glass_background"
                app:cardCornerRadius="80dp"
                app:cardElevation="32dp"
                app:strokeColor="@color/sk_neon_cyan"
                app:strokeWidth="3dp">

                <ImageView
                    android:id="@+id/ivPowerIcon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_security_shield"
                    app:tint="@color/sk_neon_cyan" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvToggleHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:alpha="0.7"
                android:text="לחץ להפעלה/כיבוי"
                android:textColor="@color/sk_white"
                android:textSize="14sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Parent Settings Button (Secondary) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenDashboard"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/main_open_dashboard"
        android:textColor="@color/sk_white"
        android:textSize="16sp"
        android:alpha="0.8"
        app:icon="@drawable/ic_security_shield"
        app:iconTint="@color/sk_neon_cyan"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
